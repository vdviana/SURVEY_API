  "items": [
    { "itemId": "ipip50_01", "sequenceIndex": 1, "itemTextEn": "Am the life of the party.", "scaleKey": "extraversion", "keyedDirection": 1 },
    { "itemId": "ipip50_02", "sequenceIndex": 2, "itemTextEn": "Feel little concern for others.", "scaleKey": "agreeableness", "keyedDirection": -1 },
    { "itemId": "ipip50_03", "sequenceIndex": 3, "itemTextEn": "Am always prepared.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_04", "sequenceIndex": 4, "itemTextEn": "Get stressed out easily.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_05", "sequenceIndex": 5, "itemTextEn": "Have a rich vocabulary.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_06", "sequenceIndex": 6, "itemTextEn": "Don't talk a lot.", "scaleKey": "extraversion", "keyedDirection": -1 },
    { "itemId": "ipip50_07", "sequenceIndex": 7, "itemTextEn": "Am interested in people.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_08", "sequenceIndex": 8, "itemTextEn": "Leave my belongings around.", "scaleKey": "conscientiousness", "keyedDirection": -1 },
    { "itemId": "ipip50_09", "sequenceIndex": 9, "itemTextEn": "Am relaxed most of the time.", "scaleKey": "emotional_stability", "keyedDirection": 1 },
    { "itemId": "ipip50_10", "sequenceIndex": 10, "itemTextEn": "Have difficulty understanding abstract ideas.", "scaleKey": "intellect", "keyedDirection": -1 },
    { "itemId": "ipip50_11", "sequenceIndex": 11, "itemTextEn": "Feel comfortable around people.", "scaleKey": "extraversion", "keyedDirection": 1 },
    { "itemId": "ipip50_12", "sequenceIndex": 12, "itemTextEn": "Insult people.", "scaleKey": "agreeableness", "keyedDirection": -1 },
    { "itemId": "ipip50_13", "sequenceIndex": 13, "itemTextEn": "Pay attention to details.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_14", "sequenceIndex": 14, "itemTextEn": "Worry about things.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_15", "sequenceIndex": 15, "itemTextEn": "Have a vivid imagination.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_16", "sequenceIndex": 16, "itemTextEn": "Keep in the background.", "scaleKey": "extraversion", "keyedDirection": -1 },
    { "itemId": "ipip50_17", "sequenceIndex": 17, "itemTextEn": "Sympathize with others' feelings.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_18", "sequenceIndex": 18, "itemTextEn": "Make a mess of things.", "scaleKey": "conscientiousness", "keyedDirection": -1 },
    { "itemId": "ipip50_19", "sequenceIndex": 19, "itemTextEn": "Seldom feel blue.", "scaleKey": "emotional_stability", "keyedDirection": 1 },
    { "itemId": "ipip50_20", "sequenceIndex": 20, "itemTextEn": "Am not interested in abstract ideas.", "scaleKey": "intellect", "keyedDirection": -1 },
    { "itemId": "ipip50_21", "sequenceIndex": 21, "itemTextEn": "Start conversations.", "scaleKey": "extraversion", "keyedDirection": 1 },
    { "itemId": "ipip50_22", "sequenceIndex": 22, "itemTextEn": "Am not interested in other people's problems.", "scaleKey": "agreeableness", "keyedDirection": -1 },
    { "itemId": "ipip50_23", "sequenceIndex": 23, "itemTextEn": "Get chores done right away.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_24", "sequenceIndex": 24, "itemTextEn": "Am easily disturbed.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_25", "sequenceIndex": 25, "itemTextEn": "Have excellent ideas.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_26", "sequenceIndex": 26, "itemTextEn": "Have little to say.", "scaleKey": "extraversion", "keyedDirection": -1 },
    { "itemId": "ipip50_27", "sequenceIndex": 27, "itemTextEn": "Have a soft heart.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_28", "sequenceIndex": 28, "itemTextEn": "Often forget to put things back in their proper place.", "scaleKey": "conscientiousness", "keyedDirection": -1 },
    { "itemId": "ipip50_29", "sequenceIndex": 29, "itemTextEn": "Get upset easily.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_30", "sequenceIndex": 30, "itemTextEn": "Do not have a good imagination.", "scaleKey": "intellect", "keyedDirection": -1 },
    { "itemId": "ipip50_31", "sequenceIndex": 31, "itemTextEn": "Talk to a lot of different people at parties.", "scaleKey": "extraversion", "keyedDirection": 1 },
    { "itemId": "ipip50_32", "sequenceIndex": 32, "itemTextEn": "Am not really interested in others.", "scaleKey": "agreeableness", "keyedDirection": -1 },
    { "itemId": "ipip50_33", "sequenceIndex": 33, "itemTextEn": "Like order.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_34", "sequenceIndex": 34, "itemTextEn": "Change my mood a lot.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_35", "sequenceIndex": 35, "itemTextEn": "Am quick to understand things.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_36", "sequenceIndex": 36, "itemTextEn": "Don't like to draw attention to myself.", "scaleKey": "extraversion", "keyedDirection": -1 },
    { "itemId": "ipip50_37", "sequenceIndex": 37, "itemTextEn": "Take time out for others.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_38", "sequenceIndex": 38, "itemTextEn": "Shirk my duties.", "scaleKey": "conscientiousness", "keyedDirection": -1 },
    { "itemId": "ipip50_39", "sequenceIndex": 39, "itemTextEn": "Have frequent mood swings.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_40", "sequenceIndex": 40, "itemTextEn": "Use difficult words.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_41", "sequenceIndex": 41, "itemTextEn": "Don't mind being the center of attention.", "scaleKey": "extraversion", "keyedDirection": 1 },
    { "itemId": "ipip50_42", "sequenceIndex": 42, "itemTextEn": "Feel others' emotions.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_43", "sequenceIndex": 43, "itemTextEn": "Follow a schedule.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_44", "sequenceIndex": 44, "itemTextEn": "Get irritated easily.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_45", "sequenceIndex": 45, "itemTextEn": "Spend time reflecting on things.", "scaleKey": "intellect", "keyedDirection": 1 },
    { "itemId": "ipip50_46", "sequenceIndex": 46, "itemTextEn": "Am quiet around strangers.", "scaleKey": "extraversion", "keyedDirection": -1 },
    { "itemId": "ipip50_47", "sequenceIndex": 47, "itemTextEn": "Make people feel at ease.", "scaleKey": "agreeableness", "keyedDirection": 1 },
    { "itemId": "ipip50_48", "sequenceIndex": 48, "itemTextEn": "Am exacting in my work.", "scaleKey": "conscientiousness", "keyedDirection": 1 },
    { "itemId": "ipip50_49", "sequenceIndex": 49, "itemTextEn": "Often feel blue.", "scaleKey": "emotional_stability", "keyedDirection": -1 },
    { "itemId": "ipip50_50", "sequenceIndex": 50, "itemTextEn": "Am full of ideas.", "scaleKey": "intellect", "keyedDirection": 1 }
  ]
