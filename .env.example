HOST=0.0.0.0
PORT=8787
# Local Docker Postgres (DATABASE/scripts/up.ps1):
# DATABASE_URL=postgresql://survey:survey_dev_password@localhost:5432/noosphere_survey
# Neon (production/staging) — set sslmode=require; never commit real credentials:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
CORS_ORIGIN=*
LOG_LEVEL=info
RATE_LIMIT_MAX=120
RATE_LIMIT_TIME_WINDOW=1 minute
APP_VERSION_HEADER=x-survey-app-version
RESEARCHER_API_KEY=replace-with-a-long-random-secret
